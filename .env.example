# FastAPI Configuration
APP_NAME=1987 Creative Narrative Generator
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Database
DATABASE_URL=sqlite:///./narratives.db
# For PostgreSQL: postgresql://user:password@localhost/narratives_db

# Features
ENABLE_CACHING=True
CACHE_TTL=3600
